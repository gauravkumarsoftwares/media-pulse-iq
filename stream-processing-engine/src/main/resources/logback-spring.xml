<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging hardening (OWASP A09): redact emails / IPv4 from all messages.
-->
<configuration>

    <property name="MASK_PATTERN"
              value="%replace(%replace(%msg){'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}','***@***'}){'\b(?:\d{1,3}\.){3}\d{1,3}\b','***.***.***.***'}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - ${MASK_PATTERN}%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
