# =====================================================================
# app-secrets — REQUIRED keys (example / documentation only; NO real values)
#
# Synced into the 'app-secrets' Kubernetes Secret by the External Secrets
# Operator (AWS Secrets Manager / Vault) and injected into pods via envFrom.
# The base manifests reference this Secret WITHOUT 'optional', so it must
# exist (fail-closed).
#
# Copy real values into your secret manager; never commit them.
# =====================================================================

# ---- Authentication (PASETO) ----------------------------------------
# Two in-service verification modes (platform.security.paseto.mode):
#
#   mode=local  (DEFAULT, Option C / token-exchange):
#     The edge gateway verifies the external v4.public token and re-mints a
#     short-lived internal v4.local token. Services verify it with a shared
#     32-byte symmetric key. Provide that key here (hex = 64 chars, or base64).
#     The SAME key must be configured on the gateway/token-exchange issuer.
PASETO_LOCAL_KEY=
#
#   mode=public (alternative): services verify the external v4.public token
#     directly. Provide the Ed25519 public key (PEM / X.509 base64 / raw
#     hex|base64) instead:
# PASETO_PUBLIC_KEY=

# ---- Apache Pinot broker authentication (insights-query-service) --------
# Controlled by platform.pinot.auth-scheme in application-{staging,prod}.yml.
#
#   auth-scheme=NONE  — no Authorization header (open cluster, local/dev)
#
#   auth-scheme=BASIC — HTTP Basic auth.
#     Set both PINOT_USERNAME and PINOT_PASSWORD.
PINOT_USERNAME=
PINOT_PASSWORD=
#
#   auth-scheme=TOKEN — Bearer token (JWT / PASETO from Pinot's IdP).
#     Set PINOT_AUTH_TOKEN; leave username/password blank.
PINOT_AUTH_TOKEN=

# ---- Trino / Iceberg cold-tier (insights-query-service, window > 30 days) ------
# Controlled by platform.trino.enabled in application-{staging,prod}.yml.
#
# Trino user identity — sent as the X-Trino-User HTTP header.
# Must match a user in the Trino file authenticator, LDAP, or OAuth2 IdP.
TRINO_USER=
#
# Trino password for LDAP / password-file authentication clusters.
# Leave blank if the cluster only requires the user header.
TRINO_PASSWORD=
#
# Full Trino JDBC URL including catalog and schema:
#   jdbc:trino://trino-coordinator:8080/iceberg/ads
# Override here only if the host/port differs from the application-{profile}.yml default.
TRINO_JDBC_URL=
#
# TLS settings — only required when platform.trino.ssl-enabled=true and the
# Trino coordinator's TLS cert is NOT in the default JVM truststore.
TRINO_SSL_ENABLED=
TRINO_SSL_TRUSTSTORE_PATH=
TRINO_SSL_TRUSTSTORE_PASSWORD=

# ---- Kafka client authentication (SASL_SSL / mTLS) ------------------
# Protocol + mechanism have safe defaults in application-{prod,staging}.yml
# (SASL_SSL + SCRAM-SHA-512); override here only if needed:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# SASL credentials (JAAS). Spring relaxed-binding maps the env var below to
# spring.kafka.properties.sasl.jaas.config.
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=

# TLS truststore for verifying the broker (server auth).
SPRING_KAFKA_PROPERTIES_SSL_TRUSTSTORE_LOCATION=
SPRING_KAFKA_PROPERTIES_SSL_TRUSTSTORE_PASSWORD=

# Client keystore for MUTUAL TLS (mTLS) — only if the broker requires client
# certs instead of / in addition to SASL.
SPRING_KAFKA_PROPERTIES_SSL_KEYSTORE_LOCATION=
SPRING_KAFKA_PROPERTIES_SSL_KEYSTORE_PASSWORD=
SPRING_KAFKA_PROPERTIES_SSL_KEY_PASSWORD=
