# =====================================================================
# LOCAL environment variables for Docker Compose parity.
# Loaded via `env_file` in docker-compose.yml. Mirrors the 'local'
# Spring profile. Safe, non-secret values for laptop development only.
# =====================================================================
SPRING_PROFILES_ACTIVE=local
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_HOST=redis
REDIS_PORT=6379
PINOT_BROKER=pinot-controller:8099
PINOT_CONTROLLER=pinot-controller:9000

