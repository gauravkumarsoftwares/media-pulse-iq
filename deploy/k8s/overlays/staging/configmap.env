# =====================================================================
# Kustomize ConfigMap env file - STAGING overlay
# Injected as environment variables into all service pods (staging ns).
# NON-SECRET operational values only.
# =====================================================================
SPRING_PROFILES_ACTIVE=staging
KAFKA_BOOTSTRAP_SERVERS=kafka-staging:9092
REDIS_HOST=redis-staging
REDIS_PORT=6379
PINOT_BROKER=pinot-staging:8099
PINOT_CONTROLLER=pinot-staging:9000

