# =====================================================================
# Kustomize ConfigMap env file - PROD overlay
# Injected as environment variables into all service pods (prod ns).
# NON-SECRET operational values only. TLS endpoints; credentials and
# PASETO_PUBLIC_KEY are sourced from K8s Secret (External Secrets / Vault).
# =====================================================================
SPRING_PROFILES_ACTIVE=prod
KAFKA_BOOTSTRAP_SERVERS=kafka-prod-msk:9094
REDIS_HOST=redis-prod.cache
REDIS_PORT=6379
PINOT_BROKER=pinot-prod:8099
PINOT_CONTROLLER=pinot-prod:9000

