# =====================================================================
# Kustomize ConfigMap env file - DEV overlay
# Injected as environment variables into all service pods (dev namespace).
# NON-SECRET operational values only. Secrets come from K8s Secret refs.
# =====================================================================
SPRING_PROFILES_ACTIVE=dev
KAFKA_BOOTSTRAP_SERVERS=kafka-dev:9092
REDIS_HOST=redis-dev
REDIS_PORT=6379
PINOT_BROKER=pinot-dev:8099
PINOT_CONTROLLER=pinot-dev:9000

