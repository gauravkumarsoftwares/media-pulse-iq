{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "schemaVersion": 39,
  "title": "Ad Analytics Platform — Overview",
  "uid": "ad-analytics-overview",
  "tags": ["ads", "platform", "sre"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Events Ingested (last 5 m)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "sum(increase(ads_events_ingested_total{status='accepted'}[5m]))",
        "legendFormat": "Accepted"
      }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" }, "unit": "short" } }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "DLQ Events (last 5 m)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "sum(increase(ads_events_dlq_total[5m]))",
        "legendFormat": "DLQ"
      }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "short" },
        "overrides": [{ "matcher": { "id": "byName", "options": "DLQ" },
          "properties": [{ "id": "thresholds", "value": { "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }] }}] }] }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Attributions (last 5 m)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "sum(increase(ads_events_attributed_total[5m]))",
        "legendFormat": "Conversions"
      }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" }, "unit": "short" } }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Redis Cache Hit Rate",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "sum(rate(ads_queries_cache_hits_total[5m])) / (sum(rate(ads_queries_cache_hits_total[5m])) + sum(rate(ads_queries_cache_misses_total[5m])))",
        "legendFormat": "Hit Rate"
      }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "yellow", "value": 0.7 },
          { "color": "green", "value": 0.9 }
        ]}}}
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Kafka Consumer Lag",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "max(kafka_consumer_group_lag{consumergroup=~'.*stream-processing-engine.*'})",
        "legendFormat": "Max Lag"
      }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 100000 },
          { "color": "red", "value": 500000 }
        ]}}}
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Dedup State Size",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "ads_dedup_state_size", "legendFormat": "Keys" }],
      "options": { "colorMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Ingest Rate by Event Type (events/s)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "sum(rate(ads_events_ingested_total{status='accepted'}[1m])) by (eventType)",
        "legendFormat": "{{eventType}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } }
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "DLQ Rate by Reason (events/s)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "sum(rate(ads_events_dlq_total[1m])) by (reason)",
        "legendFormat": "{{reason}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 },
        "color": { "fixedColor": "red", "mode": "fixed" } } }
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Ingest p50 / p95 / p99 Latency",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ads_ingest_latency_seconds_bucket[2m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ads_ingest_latency_seconds_bucket[2m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ads_ingest_latency_seconds_bucket[2m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "Query Latency by Serving Tier (p95)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(ads_queries_latency_seconds_bucket[2m])) by (le, tier))",
        "legendFormat": "p95 {{tier}}"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Stream Processing Throughput (events/s)",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(ads_events_processed_total[1m]))",
          "legendFormat": "Processed"
        },
        {
          "expr": "sum(rate(ads_events_dedup_dropped_total[1m]))",
          "legendFormat": "Dedup Dropped"
        },
        {
          "expr": "sum(rate(ads_events_attributed_total[1m]))",
          "legendFormat": "Attributed (CTB)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } }
    },

    {
      "id": 31,
      "type": "timeseries",
      "title": "Kafka Consumer Group Lag",
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "kafka_consumer_group_lag{consumergroup=~'.*ads.*'}",
        "legendFormat": "{{consumergroup}}"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 100000 },
          { "color": "red", "value": 500000 }
        ]}}}
    },

    {
      "id": 32,
      "type": "timeseries",
      "title": "Query Throughput by Tier (QPS)",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "sum(rate(ads_queries_total_total[1m])) by (tier)",
        "legendFormat": "{{tier}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } }
    },

    {
      "id": 40,
      "type": "timeseries",
      "title": "JVM Heap Usage by Service (%)",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "jvm_memory_used_bytes{area='heap'} / jvm_memory_max_bytes{area='heap'}",
        "legendFormat": "{{job}}"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.75 },
          { "color": "red", "value": 0.90 }
        ]},
        "custom": { "lineWidth": 2 }}}
    },

    {
      "id": 41,
      "type": "timeseries",
      "title": "Top Tenants — Ingest Rate (events/s)",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "topk(10, sum(rate(ads_events_ingested_total{status='accepted'}[5m])) by (tenantId))",
        "legendFormat": "{{tenantId}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } }
    }

  ]
}

