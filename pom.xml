<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.java</groupId>
    <artifactId>media-pulse-iq</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>shared-model</module>
        <module>shared-security</module>
        <module>ingestion-service</module>
        <module>stream-processing-engine</module>
        <module>insights-query-service</module>
    </modules>

    <!-- Confluent artifacts (kafka-avro-serializer) are not on Maven Central. -->
    <repositories>
        <repository>
            <id>confluent</id>
            <name>Confluent Maven Repository</name>
            <url>https://packages.confluent.io/maven/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Pin Surefire to a version that is reliably available; avoids the broken 3.0.0 resolution -->
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
        <!-- Pin Jar plugin to a fully-cached version; avoids unresolved maven-archiver 3.6.0 deps -->
        <maven-jar-plugin.version>3.4.1</maven-jar-plugin.version>
        <!-- BouncyCastle (XChaCha20 + BLAKE2b for PASETO v4.local); not managed by the Spring Boot BOM. -->
        <bouncycastle.version>1.84</bouncycastle.version>
        <!-- Apache Avro: Kafka wire format for all ShoppingEvent topics (§2.1). -->
        <avro.version>1.11.3</avro.version>
        <!-- Confluent: KafkaAvroSerializer / KafkaAvroDeserializer + Schema Registry. -->
        <confluent.version>7.7.1</confluent.version>
        <!-- Lombok version aligned with the Spring Boot BOM — used explicitly in
             shared-model's annotationProcessorPaths to ensure it runs alongside
             avro-compiler on the compile classpath. -->
        <lombok.version>1.18.38</lombok.version>
        <!-- Apache Flink: stream-processing-engine production runtime -->
        <flink.version>1.19.1</flink.version>
        <flink.connector.kafka.version>3.2.0-1.19</flink.connector.kafka.version>
        <!-- Apache Pinot Java client: native async SDK (JsonAsyncHttpPinotClientTransportFactory) -->
        <pinot.client.version>1.3.0</pinot.client.version>
        <!-- Trino JDBC: cold-tier federated queries over Iceberg/S3 Parquet (§4.3) -->
        <trino.jdbc.version>455</trino.jdbc.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
            <!-- Keep Lombok out of the repackaged Spring Boot fat jars (compile-time only). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
              Explicitly register Lombok as an annotation processor path.
              This is required when third-party compile-time dependencies (avro-compiler,
              kafka-avro-serializer) are present on the classpath: Maven compiler 3.x
              respects annotationProcessorPaths over automatic classpath discovery when
              ANY path entry is present, so Lombok must be listed explicitly here to
              ensure it still runs in all modules.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencies>
        <!-- Lombok is available project-wide as a compile-time-only dependency. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- Internal shared module, version-aligned across the monorepo -->
            <dependency>
                <groupId>com.java</groupId>
                <artifactId>shared-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Internal shared security (PASETO v4.public verifier) -->
            <dependency>
                <groupId>com.java</groupId>
                <artifactId>shared-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- BouncyCastle (PASETO v4.local crypto) — version not in the Spring Boot BOM -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!-- Apache Avro — Kafka wire-format serialisation for ShoppingEvent (§2.1) -->
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>${avro.version}</version>
            </dependency>
            <!-- avro-compiler: Idl parser to load .avdl schema at runtime -->
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-compiler</artifactId>
                <version>${avro.version}</version>
            </dependency>
            <!-- Confluent Kafka Avro SerDes: KafkaAvroSerializer / KafkaAvroDeserializer -->
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-avro-serializer</artifactId>
                <version>${confluent.version}</version>
            </dependency>

            <!-- ===== Apache Flink (stream-processing-engine) ===== -->
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-streaming-java</artifactId>
                <version>${flink.version}</version>
                <!-- Provided when submitting to a Flink cluster; compile for embedded/local mode -->
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-clients</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-statebackend-rocksdb</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-connector-base</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-connector-kafka</artifactId>
                <version>${flink.connector.kafka.version}</version>
            </dependency>

            <!-- Apache Pinot Java client: native async SDK (JsonAsyncHttpPinotClientTransportFactory) -->
            <dependency>
                <groupId>org.apache.pinot</groupId>
                <artifactId>pinot-java-client</artifactId>
                <version>${pinot.client.version}</version>
                <exclusions>
                    <!-- Exclude server-side Pinot artifacts pulled transitively -->
                    <exclusion>
                        <groupId>org.apache.pinot</groupId>
                        <artifactId>pinot-server</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- Trino JDBC: cold-tier federated queries over Apache Iceberg / S3 Parquet.
                 trino-jdbc 455+ is a self-contained JAR that shades its internal dependencies
                 (Jackson, OkHttp, etc.) to prevent classpath conflicts with Spring Boot. -->
            <dependency>
                <groupId>io.trino</groupId>
                <artifactId>trino-jdbc</artifactId>
                <version>${trino.jdbc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>